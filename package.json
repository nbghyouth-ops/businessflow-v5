  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "node scripts/migrate.mjs",
    "db:bundle": "node scripts/bundle-sql.mjs",
    "db:check": "node scripts/preflight.mjs",
    "smoke": "node scripts/smoke-api.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm audit --omit=dev",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
