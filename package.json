    "jose": "6.2.17",
    "jsdom": "27.0.1",
    "postcss": "8.5.33",
    "tailwindcss": "4.1.17",
    "typescript": "^5.9.3",
    "vitest": "5.1.0",
    "vitest-axe": "0.1.0"
