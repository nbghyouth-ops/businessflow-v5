    "@node-rs/argon2": "2.2.2",
    "better-auth": "1.7.23",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "jspdf": "4.2.1",
    "next": "16.4.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
